{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pcvantol/forge-platform/schemas/universal-installer-composition-catalog.schema.json",
  "title": "Forge Platform universal installer composition catalog",
  "description": "Signed, expiring index of immutable qualified Forge/EP/Workspace compositions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "sequence", "channel", "published_at", "expires_at", "compositions", "signatures"],
  "properties": {
    "schema": {"const": "forge-platform.composition-catalog/v1"},
    "sequence": {"type": "integer", "minimum": 1},
    "channel": {"enum": ["stable", "candidate"]},
    "published_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "compositions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/composition"}
    },
    "signatures": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/public_signature_envelope"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "https_url": {"type": "string", "pattern": "^https://[^\\s@/]+(?:/[^\\s]*)?$"},
    "public_signature_envelope": {
      "description": "Public Ed25519 signature envelope. Key material remains in the installer trust root; the signature is 64 raw bytes encoded as canonical unpadded base64url.",
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "signature"],
      "properties": {
        "algorithm": {"const": "ed25519"},
        "key_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
        "signature": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}$"}
      }
    },
    "installer_requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_version", "capabilities"],
      "properties": {
        "minimum_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
        "capabilities": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9./_-]{0,127}$"},
          "uniqueItems": true
        }
      }
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["composition_id", "channel", "url", "digest", "requires_installer"],
      "properties": {
        "composition_id": {"type": "string", "minLength": 1},
        "channel": {"enum": ["stable", "candidate"]},
        "url": {"$ref": "#/$defs/https_url"},
        "digest": {"$ref": "#/$defs/sha256"},
        "requires_installer": {"$ref": "#/$defs/installer_requirement"}
      }
    }
  }
}
