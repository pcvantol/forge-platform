{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pcvantol/forge-platform/schemas/universal-installer-composition.schema.json",
  "title": "Forge Platform universal installer composition",
  "description": "The immutable, digest-pinned component and host policy consumed after catalog verification.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "composition_id", "channel", "requires_installer", "host_requirements", "managed_tools", "providers", "components", "upgrade_from"],
  "properties": {
    "schema": {"const": "forge-platform.composition/v1"},
    "composition_id": {"type": "string", "minLength": 1},
    "channel": {"enum": ["stable", "candidate"]},
    "requires_installer": {"$ref": "#/$defs/installer_requirement"},
    "host_requirements": {"$ref": "#/$defs/host_requirement"},
    "managed_tools": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/managed_tool"}
    },
    "providers": {
      "type": "array",
      "items": {"$ref": "#/$defs/provider"}
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/component"}
    },
    "upgrade_from": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "https_url": {"type": "string", "pattern": "^https://[^\\s@/]+(?:/[^\\s]*)?$"},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "installer_requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_version", "capabilities"],
      "properties": {
        "minimum_version": {"$ref": "#/$defs/version"},
        "capabilities": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9./_-]{0,127}$"},
          "uniqueItems": true
        }
      }
    },
    "host_requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_macos_version", "supported_architectures", "minimum_available_disk_bytes", "backup_reserve_bytes", "minimum_memory_bytes", "requires_administrator", "requires_network", "requires_trusted_clock"],
      "properties": {
        "minimum_macos_version": {"$ref": "#/$defs/version"},
        "supported_architectures": {"type": "array", "minItems": 1, "items": {"enum": ["arm64", "x86_64"]}, "uniqueItems": true},
        "minimum_available_disk_bytes": {"type": "integer", "minimum": 0},
        "backup_reserve_bytes": {"type": "integer", "minimum": 0},
        "minimum_memory_bytes": {"type": "integer", "minimum": 0},
        "requires_administrator": {"type": "boolean"},
        "requires_network": {"type": "boolean"},
        "requires_trusted_clock": {"type": "boolean"}
      }
    },
    "managed_tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "version", "url", "digest"],
      "properties": {
        "identity": {"enum": ["git", "python"]},
        "version": {"$ref": "#/$defs/version"},
        "url": {"$ref": "#/$defs/https_url"},
        "digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "required", "minimum_version", "credential_scope"],
      "properties": {
        "identity": {"enum": ["codex", "github-cli"]},
        "required": {"type": "boolean"},
        "minimum_version": {"anyOf": [{"$ref": "#/$defs/version"}, {"type": "null"}]},
        "credential_scope": {"const": "user"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "source_revision", "source", "digest", "qualification"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "source_revision": {"type": "string", "minLength": 1},
        "source": {"$ref": "#/$defs/https_url"},
        "digest": {"$ref": "#/$defs/sha256"},
        "qualification": {"type": "string", "minLength": 1}
      }
    },
    "system_service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manager", "domain", "kind", "product_service_reference"],
      "properties": {
        "manager": {"const": "launchd"},
        "domain": {"const": "system"},
        "kind": {"const": "LaunchDaemon"},
        "product_service_reference": {"type": "string", "minLength": 1}
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "role", "artifact", "service"],
      "properties": {
        "identity": {"enum": ["forge-runtime", "workspace-server", "workspace-client", "engineering-platform-server", "engineering-platform-project-agent"]},
        "role": {"type": "string", "minLength": 1},
        "artifact": {"$ref": "#/$defs/artifact"},
        "service": {"anyOf": [{"$ref": "#/$defs/system_service"}, {"type": "null"}]}
      },
      "allOf": [
        {
          "if": {"properties": {"identity": {"enum": ["forge-runtime", "workspace-server", "engineering-platform-server"]}}},
          "then": {"properties": {"service": {"$ref": "#/$defs/system_service"}}},
          "else": {"properties": {"service": {"type": "null"}}}
        }
      ]
    }
  }
}
